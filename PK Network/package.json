{
  "name": "pk-network",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"Vite,Worker\" -c \"cyan.bold,yellow.bold\" \"vite\" \"wrangler dev worker/index.ts\"",
    "dev:vite": "vite",
    "dev:worker": "wrangler dev worker/index.ts",
    "build": "tsc -b && vite build",
    "lint": "tsc -b --noEmit",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "push": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^3.101.0"
  }
}
