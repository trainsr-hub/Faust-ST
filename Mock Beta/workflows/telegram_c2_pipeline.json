{
  "$schema": "https://faust.c2/schemas/v1/workflow.json",
  "id": "telegram_c2_pipeline",
  "name": "Work via Telegram Autonomous Workflow",
  "version": "2.1.0",
  "description": "Multi-branching, parallel event-driven Telegram C2 workflow with security gating, agentic debate, and acoustic egress.",
  "invariants": {
    "zero_llm_primacy": true,
    "max_token_burn_idle": 0,
    "delivery_guarantee": "at_least_once"
  },
  "nodes": [
    {
      "id": "telegram_ingress",
      "name": "Telegram Ingress",
      "icon": "⏰",
      "tool": "Telegram Daemon (Port 20130)",
      "category": "trigger",
      "description": "Long-polls getUpdates from Telegram group chat with sliding-window deduplication.",
      "type": "trigger",
      "execution_mode": "zero_llm",
      "output_ports": ["main"],
      "target": "http://127.0.0.1:20130/messages/pop",
      "retry_policy": { "max_retries": 3, "backoff_ms": 500, "continue_on_error": false },
      "depends_on": []
    },
    {
      "id": "security_gate",
      "name": "Security & Whitelist Gate",
      "icon": "🔒",
      "tool": "Identity Whitelist Guard",
      "category": "security",
      "description": "Verifies sender ID matches Manager (8016442589) and chat ID matches C2 channel.",
      "type": "conditional_split",
      "execution_mode": "zero_llm",
      "output_ports": ["authorized", "rejected"],
      "condition": "payload.chat_id == -1004405650953 and payload.sender_id == 8016442589",
      "depends_on": ["telegram_ingress"]
    },
    {
      "id": "security_alert_egress",
      "name": "Intrusion Drop & Alert",
      "icon": "🚨",
      "tool": "Audit Log Daemon",
      "category": "security",
      "description": "Logs unauthorized intrusion attempt to security audit log and drops payload.",
      "type": "deterministic_filter",
      "execution_mode": "zero_llm",
      "output_ports": ["main"],
      "target": "log_intrusion_alert",
      "depends_on": ["security_gate"]
    },
    {
      "id": "directive_classifier",
      "name": "Intent Classifier & Router",
      "icon": "🔀",
      "tool": "Regex Router (Zero-LLM)",
      "category": "routing",
      "description": "Classifies incoming text into system commands (/status, /voice) vs autonomous tasks.",
      "type": "switch_router",
      "execution_mode": "regex_first_fallback_faust_st",
      "output_ports": ["task_directive", "system_command"],
      "rules": {
        "^/status": "system_command",
        "^/stop": "system_command",
        "^/voice": "system_command",
        "default": "task_directive"
      },
      "depends_on": ["security_gate"]
    },
    {
      "id": "intake_notify_telegram",
      "name": "Telegram Intake Alert",
      "icon": "📱",
      "tool": "Telegram REST (Port 20130)",
      "category": "messaging",
      "group": "parallel_intake",
      "description": "Transmits immediate '🔄 Prescript Received' confirmation to the Telegram C2 chat.",
      "type": "deterministic_daemon",
      "execution_mode": "zero_llm",
      "output_ports": ["main"],
      "target": "http://127.0.0.1:20130/send",
      "payload": { "emoji": "🔄", "text": "Prescript Received: {{payload.text}}" },
      "depends_on": ["directive_classifier"]
    },
    {
      "id": "intake_notify_audio",
      "name": "Kokoro Speech Alert",
      "icon": "🔊",
      "tool": "Kokoro-82M ONNX (Port 20129)",
      "category": "speech",
      "group": "parallel_intake",
      "description": "Synthesizes 'Executing your directive, Manager' voice brief to physical speakers.",
      "type": "deterministic_daemon",
      "execution_mode": "zero_llm",
      "output_ports": ["main"],
      "target": "http://127.0.0.1:20129/speak",
      "payload": { "text": "Executing your directive, Manager." },
      "depends_on": ["directive_classifier"]
    },
    {
      "id": "execution_router",
      "name": "C2 Dispatcher & Checksum",
      "icon": "⚡",
      "tool": "Deterministic Dispatcher (0-LLM)",
      "category": "system",
      "description": "Validates SHA-256 blueprint hash and shreds task into atomic work packets.",
      "type": "synchronize_fan_in",
      "execution_mode": "zero_llm",
      "output_ports": ["main"],
      "script": ".claude/skills/c2-dispatch/scripts/faust_dispatcher.py",
      "depends_on": ["intake_notify_telegram", "intake_notify_audio"]
    },
    {
      "id": "faust_theorist",
      "name": "Theorist Architecture",
      "icon": "🧠",
      "tool": "Faust-ND (Sonnet 4.6 Thinking)",
      "category": "ai_agent",
      "group": "parallel_cognitive",
      "description": "Drafts strategic technical blueprints, contract definitions, and architecture plans.",
      "type": "cognitive_agent_matrix",
      "execution_mode": "faust_nd",
      "output_ports": ["main"],
      "tiers": { "role": "Stratum I Strategic Architect (Sonnet Thinking)" },
      "depends_on": ["execution_router"]
    },
    {
      "id": "faust_critic",
      "name": "Critic Inquisitor",
      "icon": "⚔️",
      "tool": "Faust-ND (Gemini Flash High)",
      "category": "ai_agent",
      "group": "parallel_cognitive",
      "description": "Adversarially stress-tests the blueprint, hunts edge cases, and audits trade-offs.",
      "type": "cognitive_agent_matrix",
      "execution_mode": "faust_nd",
      "output_ports": ["main"],
      "tiers": { "role": "Stratum I Adversarial Peer Review (Flash High)" },
      "depends_on": ["execution_router"]
    },
    {
      "id": "faust_machinist",
      "name": "Tactical Machinist",
      "icon": "⚙️",
      "tool": "Faust-TH (Qwen3 / Llama 3.3)",
      "category": "ai_agent",
      "description": "Fabricates code and runs compiler validation (tsc/pytest) with self-healing retries.",
      "type": "cognitive_agent_matrix",
      "execution_mode": "faust_th",
      "output_ports": ["main"],
      "compiler_self_healing_retries": 4,
      "tiers": { "role": "Stratum III Tactical Fabrication" },
      "depends_on": ["faust_theorist", "faust_critic"]
    },
    {
      "id": "debrief_egress_tg",
      "name": "Telegram Egress Debrief",
      "icon": "📤",
      "tool": "Telegram REST (Port 20130)",
      "category": "messaging",
      "group": "parallel_egress",
      "description": "Transmits final execution debrief with '✅ Task Complete' report to group chat.",
      "type": "deterministic_daemon",
      "execution_mode": "zero_llm",
      "output_ports": ["main"],
      "target": "http://127.0.0.1:20130/send",
      "payload": { "emoji": "✅", "text": "{{faust_machinist.report}}" },
      "depends_on": ["faust_machinist"]
    },
    {
      "id": "debrief_egress_audio",
      "name": "Speech Synthesis Summary",
      "icon": "🎙️",
      "tool": "Kokoro-82M ONNX (Port 20129)",
      "category": "speech",
      "group": "parallel_egress",
      "description": "Synthesizes verbal debriefing summary of accomplishments through speakers.",
      "type": "deterministic_daemon",
      "execution_mode": "zero_llm",
      "output_ports": ["main"],
      "target": "http://127.0.0.1:20129/speak",
      "payload": { "text": "{{faust_machinist.voice_summary}}" },
      "depends_on": ["faust_machinist"]
    },
    {
      "id": "transactional_ack",
      "name": "Commit Transaction & ACK",
      "icon": "🌐",
      "tool": "SQLite WAL Engine",
      "category": "persistence",
      "description": "Commits update_id to SQLite WAL disk queue and purges active directive snapshot.",
      "type": "deterministic_ack",
      "execution_mode": "zero_llm",
      "output_ports": [],
      "target": "http://127.0.0.1:20130/messages/ack",
      "payload": { "update_id": "{{payload.update_id}}" },
      "depends_on": ["debrief_egress_tg", "debrief_egress_audio"]
    }
  ]
}
