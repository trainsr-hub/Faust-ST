{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FaustWorkflowSchema",
  "description": "Strict JSON Schema for Faust AI-Native Directed Acyclic Graph (DAG) Workflows with Multi-Branching, Visual Iconography, and Tool Metadata.",
  "type": "object",
  "required": ["$schema", "id", "name", "version", "invariants", "nodes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "invariants": {
      "type": "object",
      "required": ["zero_llm_primacy"],
      "properties": {
        "zero_llm_primacy": { "type": "boolean" },
        "max_token_burn_idle": { "type": "number" },
        "delivery_guarantee": {
          "type": "string",
          "enum": ["at_least_once", "at_most_once", "exactly_once"]
        }
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/WorkflowNode"
      }
    }
  },
  "definitions": {
    "RetryPolicy": {
      "type": "object",
      "properties": {
        "max_retries": { "type": "integer", "minimum": 0 },
        "backoff_ms": { "type": "integer", "minimum": 0 },
        "continue_on_error": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "ActionSpec": {
      "type": "object",
      "required": ["target"],
      "properties": {
        "target": { "type": "string" },
        "payload": { "type": ["object", "string"] }
      },
      "additionalProperties": true
    },
    "ConnectionSpec": {
      "type": "object",
      "required": ["node_id"],
      "properties": {
        "node_id": { "type": "string" },
        "from_port": { "type": "string" },
        "to_port": { "type": "string" }
      },
      "additionalProperties": false
    },
    "WorkflowNode": {
      "type": "object",
      "required": ["id", "name", "type", "execution_mode", "depends_on"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": [
            "trigger",
            "deterministic_daemon",
            "deterministic_filter",
            "hybrid_classifier",
            "deterministic_multicast",
            "deterministic_dag_shredder",
            "cognitive_agent_matrix",
            "deterministic_ack",
            "system_exec",
            "code_transform",
            "database_op",
            "conditional_split",
            "switch_router",
            "parallel_fan_out",
            "synchronize_fan_in"
          ]
        },
        "execution_mode": {
          "type": "string",
          "enum": [
            "zero_llm",
            "regex_first_fallback_faust_st",
            "faust_multi_combo",
            "faust_st",
            "faust_nd",
            "faust_th",
            "deterministic_multicast"
          ]
        },
        "icon": { "type": "string" },
        "tool": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "group": { "type": "string" },
        "output_ports": {
          "type": "array",
          "items": { "type": "string" }
        },
        "target": { "type": "string" },
        "condition": { "type": "string" },
        "on_failure": {
          "type": "string",
          "enum": ["abort_and_log", "retry", "continue", "escalate_to_manager"]
        },
        "rules": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/definitions/ActionSpec" }
        },
        "script": { "type": "string" },
        "tiers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "compiler_self_healing_retries": { "type": "integer", "minimum": 0 },
        "payload": { "type": ["object", "string"] },
        "retry_policy": { "$ref": "#/definitions/RetryPolicy" },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" }
        },
        "connections": {
          "type": "array",
          "items": { "$ref": "#/definitions/ConnectionSpec" }
        }
      }
    }
  }
}
