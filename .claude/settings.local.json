{
  "permissions": {
    "allow": [
      "PowerShell(*)",
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Skill(*)",
      "Agent(*)",
      "NotebookEdit(*)",
      "mcp_ide_getDiagnostics(*)",
      "mcp_ide_executeCode(*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/scripts/faust_turn_hook.py",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/scripts/faust_turn_hook.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
